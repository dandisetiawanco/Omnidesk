# OmniDesk local runtime configuration example.
# Do NOT store AI provider API keys in this file or any plaintext file.
# API keys are saved exclusively in the OS secure credential store:
#   macOS: Keychain
#   Windows: Windows Credential Manager
#   Linux: Secret Service (libsecret / KWallet)

# Local backend bind settings (loopback only; never bind 0.0.0.0)
OMNIDESK_HOST=127.0.0.1
OMNIDESK_PORT=17420

# Ephemeral session token is generated at launch by the Tauri shell.
# For standalone backend development only, set a random 32+ char token:
# OMNIDESK_SESSION_TOKEN=replace-with-random-secret-for-local-dev

# Local SQLite database directory (defaults to OS application data folder)
# OMNIDESK_DATA_DIR=

# Privacy mode: "local_only" or "cloud_assisted"
OMNIDESK_PRIVACY_MODE=local_only

# Optional Ollama base URL when running local models
OMNIDESK_OLLAMA_URL=http://127.0.0.1:11434

# Optional OpenAI-compatible local or enterprise endpoint URL
# OMNIDESK_OPENAI_COMPAT_URL=http://127.0.0.1:8080/v1
